@page "/feedback/details/{FormId:int}"
@attribute [Authorize]
@using Newtonsoft.Json
@inject IFeedbackQueryService FeedbackQueryService
@inject IUserService UserService
@inject NavigationManager NavigationManager
@inject ILogger<FeedbackFormDetails> Logger

@if (isLoading)
{
    <p>Loading Feedback Form Details...</p>
}
else if (feedbackForm == null)
{
    <p>No Feedback Form found for ID: @FormId</p>
}
else
{
    <div class="card mt-2">
        <div class="card-body">
            <h4>@feedbackForm.Name</h4>
            <p>@feedbackForm.Description</p>
            <p>Successful submits: @feedbackForm.SubmitCount</p>

            @if (feedbackForm.Summery != null)
            {
                <h5>Summery</h5>
                <p><b>Average Rating:</b> @feedbackForm.Summery.AverageRating</p>
                <p><b>Total Responses:</b> @feedbackForm.Summery.TotalResponses</p>
                <!-- weitere Felder... -->
            }
            else
            {
                <p>No summery available yet.</p>
            }

            <h5>Questions</h5>
            @if (feedbackForm.Questions == null || !feedbackForm.Questions.Any())
            {
                <p>No questions yet.</p>
            }
            else
            {
                <ul>
                    @foreach (var q in feedbackForm.Questions)
                    {
                        <li>
                            <b>@q.QuestionText</b>
                            (<em>@q.QuestionType</em>)
                        </li>
                    }
                </ul>
            }

        </div>
    </div>
}

@if (feedbackForm?.Link is not null)
{
    <hr />
    <div class="card mt-3">
        <div class="card-header">
            <h5>Share Feedback Link</h5>
        </div>
        <div class="card-body">
            @* Kompletter Link zusammenbauen *@
            @if (!string.IsNullOrEmpty(fullLink))
            {
                <p><strong>Temporary Link:</strong> @fullLink</p>

                <!-- Copy Button -->
                <button class="btn btn-outline-secondary" @onclick="CopyLinkToClipboard">
                    <i class="bi bi-clipboard"></i> Copy Link
                </button>

                <!-- Optional: Mailto-Link -->
                <button class="btn btn-outline-primary ms-2" @onclick="OpenMailToLink">
                    <i class="bi bi-envelope"></i> Share via Email
                </button>
            }
            else
            {
                <p>No valid link found.</p>
            }
        </div>
    </div>
}
else
{
    <p>This feedback form has no generated link yet.</p>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <p style="color:red">@errorMessage</p>
}

@if (!string.IsNullOrEmpty(copyMessage))
{
    <div class="alert alert-success mt-2">
        @copyMessage
    </div>
}


@code {
    [Parameter]
    public int FormId { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = default!;

    private FeedbackFormDetailsDTO? feedbackForm;
    private bool isLoading = true;
    private string errorMessage = string.Empty;
    private string? fullLink;
    private string copyMessage = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = await UserService.GetCurrentUserIdAsync();
            if (userId == null)
            {
                NavigationManager.NavigateTo("/Account/Login", true);
                return;
            }
            feedbackForm = await FeedbackQueryService.GetFeedbackFormDetailsAsync(FormId);
            if (feedbackForm?.Link != null)
            {
                fullLink = NavigationManager.BaseUri
                    + "public-feedback/"
                    + feedbackForm.Link.Token;
            }

        }
        catch (ServiceException ex)
        {
            errorMessage = "An unexpected error occurred while loading the feedback form details.";
            Logger.LogError(ex, "Unexpected exception in {Method}.", nameof(OnInitializedAsync));
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CopyLinkToClipboard()
    {
        if (!string.IsNullOrEmpty(fullLink))
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", fullLink);
            copyMessage = "Link copied to clipboard!";
        }
    }


    private void OpenMailToLink()
    {
        if (!string.IsNullOrEmpty(fullLink))
        {
            var subject = Uri.EscapeDataString("Check out this feedback form");
            var body = Uri.EscapeDataString($"Hello,\n\nPlease fill out this feedback form:\n{fullLink}");
            var mailtoUrl = $"mailto:?subject={subject}&body={body}";
            NavigationManager.NavigateTo(mailtoUrl);
        }
    }
}