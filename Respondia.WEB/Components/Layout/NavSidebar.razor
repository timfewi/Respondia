@implements IDisposable
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject NavigationManager NavigationManager

<AuthorizeView>
    <!--
        1) d-flex flex-column: Aktiviert Flexbox in Spaltenrichtung.
        2) height: 100vh -> passt die Sidebar auf die volle Browser-Höhe an.
        3) p-3, width: 280px -> deine gewohnte Optik.
    -->
    <div class="flex-shrink-0 fixed-top d-flex flex-column p-3 bg-white border-end"
         style="width: 280px; height: 100vh;">

        <!-- Titel / Logo-Bereich -->
        <a href="/" class="d-flex align-items-center pb-3 mb-3 link-body-emphasis text-decoration-none border-bottom">
            <i class="bi pe-none me-2" width="30" height="24">
                <use xlink:href="#bootstrap"></use>
            </i>
            <span class="fs-5 fw-semibold"><i class="bi bi-file-earmark-spreadsheet-fill me-2"></i>Respondia Panel</span>
        </a>

        <!--
            2) Obere Menüpunkte
            -> flex-grow-1 (oder mb-auto) sorgt dafür,
               dass dieser Block sich "nach oben ausdehnt"
               und der Account-Bereich unten bleibt.
        -->
        <ul class="list-unstyled ps-0 flex-grow-1">
            <!-- Menu Item 1 -->
            <li class="mb-1">
                <button class="btn btn-toggle d-inline-flex align-items-end rounded border-0 collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#dashboard-collapse"
                        aria-expanded="false">
                    <i class="bi bi-chevron-right me-2"></i>
                    Dashboard
                </button>
                <div class="collapse" id="dashboard-collapse">
                    <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                        <li>
                            <a href="#" class="link-body-emphasis d-inline-flex text-decoration-none rounded">
                                Overview
                            </a>
                        </li>
                        <li>
                            <a href="#" class="link-body-emphasis d-inline-flex text-decoration-none rounded">
                                Updates
                            </a>
                        </li>
                        <li>
                            <a href="#" class="link-body-emphasis d-inline-flex text-decoration-none rounded">
                                Reports
                            </a>
                        </li>
                    </ul>
                </div>
            </li>

            <!-- Menu Item 2 -->
            <li class="mb-1">
                <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed"
                        data-bs-toggle="collapse"
                        data-bs-target="#campaigns-collapse"
                        aria-expanded="false">
                    <i class="bi bi-chevron-right me-2"></i>
                    Campaigns
                </button>
                <div class="collapse" id="campaigns-collapse">
                    <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                        <li><NavLink href="/campaigns" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Overview</NavLink></li>
                        <li><NavLink href="/campaigns/create" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Create</NavLink></li>
                        <li><a href="#" class="link-body-emphasis d-inline-flex text-decoration-none rounded">Reports</a></li>
                    </ul>
                </div>
            </li>
        </ul>

        <!--
            3) Account-Bereich
            -> durch die flex-column & flex-grow-1 oben
               "wandert" dieser Bereich an den unteren Rand.
        -->
        <div class="border-top pt-3">
            <ul class="list-unstyled ps-0">
                <li class="mb-1">
                    <button class="btn btn-toggle d-inline-flex align-items-center rounded border-0 collapsed"
                            data-bs-toggle="collapse"
                            data-bs-target="#account-collapse"
                            aria-expanded="false">
                        <i class="bi bi-chevron-right me-2"></i>
                        Account
                    </button>
                    <div class="collapse" id="account-collapse">
                        <ul class="btn-toggle-nav list-unstyled fw-normal pb-1 small">
                            <li>
                                <NavLink href="/Account/Manage"
                                         class="btn btn-link text-decoration-none link-body-emphasis d-inline-flex align-items-center">
                                    <i class="bi bi-person-circle me-2"></i> Manage
                                </NavLink>
                            </li>
                            <li>
                                <form method="post" action="Account/Logout">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                                    <button type="submit" class="btn btn-link text-decoration-none link-body-emphasis d-inline-flex align-items-center">
                                        <i class="bi bi-door-closed me-2"></i> Logout
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</AuthorizeView>

@code {
    private string? currentUrl;

    protected override void OnInitialized()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
